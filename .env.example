# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# Auth.js + Google sign-in
AUTH_SECRET=              # run: npx auth secret
AUTH_GOOGLE_ID=           # dev: the hms-dev client in Google Cloud
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=iitrpr.ac.in   # empty only for local testing with a personal Gmail

# Database (empty = local file local.db; Turso: libsql://<db>-<org>.turso.io)
DATABASE_URL=
TURSO_AUTH_TOKEN=         # only for Turso
